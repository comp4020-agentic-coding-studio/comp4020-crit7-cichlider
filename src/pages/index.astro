---
import { listPlans } from "../lib/db";
import { MAJORS } from "../lib/majors";
import "../styles.css";

const plans = listPlans();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU course planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Course planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>What should I take next?</h1>
      <p>
        Pick a Computing major, list what you've already completed and what
        you're taking right now, and get back which of the major's own
        requirements are still open — and a suggested order to clear them in,
        packed into 24-unit semesters. This is a slice of ANU's course
        selection, not the whole enrolment system: see
        <a href="/readme/">the about page</a> for exactly what it does and doesn't
        model.
      </p>

      <form method="post" action="/api/plans">
        <div class="field">
          <label for="majorCode">Major</label>
          <select id="majorCode" name="majorCode" required>
            {MAJORS.map((m) => <option value={m.code}>{m.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="completed">Completed courses</label>
          <textarea
            id="completed"
            name="completed"
            rows="3"
            placeholder="COMP1100, COMP1110, MATH1005, COMP1600"></textarea>
        </div>
        <div class="field">
          <label for="inProgress">Currently taking</label>
          <textarea id="inProgress" name="inProgress" rows="2" placeholder="COMP2100, COMP2400"
          ></textarea>
        </div>
        <button>Recommend my schedule</button>
      </form>

      <h2>Saved plans</h2>
      {
        plans.length === 0 ? (
          <p>No plans yet — build one above.</p>
        ) : (
          <ul id="plans">
            {plans.map((plan) => (
              <li>
                <a href={`/plans/${plan.id}`}>
                  {MAJORS.find((m) => m.code === plan.majorCode)?.name ?? plan.majorCode}
                </a>{" "}
                — saved {plan.createdAt}
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
